<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyName>CrosshairOverlayTool</AssemblyName>
    <RootNamespace>CrosshairOverlayTool</RootNamespace>
    <Title>Crosshair Overlay Tool</Title>
    <Version>1.0.1</Version>
    <Authors>Fumiya</Authors>
    <Company>Fumiya</Company>
    <Product>Crosshair Overlay Tool</Product>
    <Description>Transparent crosshair overlay utility for Windows desktop.</Description>
    <Copyright>Copyright (c) Fumiya</Copyright>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="snapshots\**\*.cs" />
    <Compile Remove="temp\**\*.cs" />
  </ItemGroup>
</Project>
